// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoStatus {
  UPLOADING
  UPLOADED
  TRANSCODING
  TRANSCODED
  PUBLISHED
  FAILED
  ARCHIVED
}

enum TranscodeStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
}

enum VideoCodec {
  H264
  H265
  AV1
}

enum AudioCodec {
  AAC
  MP3
  OPUS
}

enum ThumbnailFormat {
  JPG
  PNG
  WEBP
}

enum LiveRoomStatus {
  NOT_STARTED
  LIVING
  ENDED
  BANNED
}

enum LiveStreamStatus {
  PUSHING
  INTERRUPTED
  STOPPED
  FAILED
}

enum LiveStreamProtocol {
  RTMP
  SRT
  RTSP
}

enum LiveTranscodeStatus {
  RUNNING
  STOPPED
  FAILED
  SWITCHED
}

enum LiveRecordingStatus {
  RECORDING
  STOPPED
  CONVERTING
  COMPLETED
  FAILED
}

enum LiveRecordingFormat {
  FLV
  HLS
  MP4
}

enum DanmakuStatus {
  NORMAL
  HIDDEN
  BANNED
}

enum GiftStatus {
  ENABLED
  DISABLED
}

enum LivePlayProtocol {
  HLS
  FLV
  WEBRTC
}

enum PlayAuthStatus {
  ALLOWED
  DENIED
  EXPIRED
}

enum TrackType {
  VIDEO
  AUDIO
  SUBTITLE
}

enum EffectType {
  TRANSITION
  FILTER
  TEXT
  PIP
  SPEED
  AUDIO
}

enum TransitionType {
  FADE
  DISSOLVE
  SLIDE_LEFT
  SLIDE_RIGHT
  SLIDE_UP
  SLIDE_DOWN
  WIPE
  CROSSFADE
}

enum FilterType {
  BRIGHTNESS
  CONTRAST
  SATURATION
  GRAYSCALE
  SEPIA
  BLUR
  SHARPEN
  VINTAGE
  CINEMATIC
  WARM
  COOL
  NEGATE
  HUE_ROTATE
}

enum TextOverlayType {
  TITLE
  WATERMARK
  SUBTITLE
  CAPTION
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model VideoEditProject {
  id          String    @id @default(uuid())
  title       String
  description String?
  videoId     String?
  video       Video?    @relation(fields: [videoId], references: [id])
  userId      String?
  timeline    Timeline?
  exportJobs  ExportJob[]
  history     EditHistory[]
  thumbnailUrl String?
  duration    Float     @default(0)
  width       Int       @default(1920)
  height      Int       @default(1080)
  fps         Int       @default(30)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([videoId])
  @@index([createdAt])
}

model Timeline {
  id         String   @id @default(uuid())
  projectId  String   @unique
  project    VideoEditProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tracks     Track[]
  duration   Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Track {
  id         String   @id @default(uuid())
  timelineId String
  timeline   Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  type       TrackType
  name       String
  index      Int
  locked     Boolean  @default(false)
  muted      Boolean  @default(false)
  visible    Boolean  @default(true)
  volume     Float    @default(1)
  clips      Clip[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([timelineId, type])
}

model Clip {
  id         String   @id @default(uuid())
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  sourcePath String
  sourceType String   @default("video")
  startTime  Float    @default(0)
  endTime    Float    @default(0)
  sourceIn   Float    @default(0)
  sourceOut  Float    @default(0)
  duration   Float    @default(0)
  name       String?
  effects    Effect[]
  speed      Float    @default(1)
  volume     Float    @default(1)
  rotation   Float    @default(0)
  scale      Float    @default(1)
  positionX  Float    @default(0)
  positionY  Float    @default(0)
  opacity    Float    @default(1)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([trackId])
}

model Effect {
  id             String       @id @default(uuid())
  clipId         String
  clip           Clip         @relation(fields: [clipId], references: [id], onDelete: Cascade)
  type           EffectType
  subtype        String?
  name           String?
  startTime      Float        @default(0)
  endTime        Float?
  duration       Float?
  parameters     Json
  transitionType TransitionType?
  filterType     FilterType?
  textType       TextOverlayType?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([clipId, type])
}

model ExportJob {
  id          String       @id @default(uuid())
  projectId   String
  project     VideoEditProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status      ExportStatus @default(PENDING)
  progress    Int          @default(0)
  outputPath  String?
  outputUrl   String?
  fileSize    BigInt?
  format      String       @default("mp4")
  videoCodec  String       @default("h264")
  audioCodec  String       @default("aac")
  width       Int          @default(1920)
  height      Int          @default(1080)
  bitrate     Int?
  fps         Int          @default(30)
  quality     String?
  errorMessage String?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
}

model EditHistory {
  id         String   @id @default(uuid())
  projectId  String
  project    VideoEditProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action     String
  snapshot   Json
  timestamp  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([projectId, timestamp])
}

model Video {
  id             String          @id @default(uuid())
  title          String
  description    String?
  fileName       String
  originalPath   String
  fileSize       BigInt
  duration       Float?
  width          Int?
  height         Int?
  bitrate        Int?
  format         String?
  status         VideoStatus     @default(UPLOADING)
  uploadId       String?
  uploadProgress Int             @default(0)
  thumbnailUrl   String?
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  tags           VideoTag[]
  transcodeTasks TranscodeTask[]
  thumbnails     Thumbnail[]
  playlists      Playlist[]
  liveRecordings LiveRecording[]
  editProjects   VideoEditProject[]
  metadata       Json?
  views          Int             @default(0)
  isPublic       Boolean         @default(true)
  expiresAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  videos      Video[]
  liveRooms   LiveRoom[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Tag {
  id        String     @id @default(uuid())
  name      String     @unique
  videos    VideoTag[]
  createdAt DateTime   @default(now())
}

model VideoTag {
  videoId String
  tagId   String
  video   Video  @relation(fields: [videoId], references: [id])
  tag     Tag    @relation(fields: [tagId], references: [id])

  @@id([videoId, tagId])
}

model TranscodeTemplate {
  id             String          @id @default(uuid())
  name           String
  description    String?
  isPreset       Boolean         @default(false)
  width          Int?
  height         Int?
  videoBitrate   Int?
  videoCodec     VideoCodec      @default(H264)
  audioBitrate   Int?
  audioCodec     AudioCodec      @default(AAC)
  framerate      Int?
  crf            Int?
  preset         String?
  outputFormat   String          @default("mp4")
  isHls          Boolean         @default(false)
  isDash         Boolean         @default(false)
  transcodeTasks TranscodeTask[]
  liveTranscodes LiveTranscode[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([isPreset])
}

model TranscodeTask {
  id           String             @id @default(uuid())
  videoId      String
  video        Video              @relation(fields: [videoId], references: [id])
  templateId   String?
  template     TranscodeTemplate? @relation(fields: [templateId], references: [id])
  templateName String
  status       TranscodeStatus    @default(PENDING)
  progress     Int                @default(0)
  outputPath   String?
  outputSize   BigInt?
  width        Int?
  height       Int?
  bitrate      Int?
  duration     Float?
  retryCount   Int                @default(0)
  maxRetries   Int                @default(3)
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([videoId])
  @@index([status])
  @@index([createdAt])
}

model Thumbnail {
  id         String          @id @default(uuid())
  videoId    String
  video      Video           @relation(fields: [videoId], references: [id])
  filePath   String
  url        String
  timePoint  Float
  width      Int
  height     Int
  format     ThumbnailFormat @default(JPG)
  fileSize   BigInt
  isSprite   Boolean         @default(false)
  spriteData Json?
  createdAt  DateTime        @default(now())

  @@index([videoId])
}

model Playlist {
  id         String   @id @default(uuid())
  videoId    String
  video      Video    @relation(fields: [videoId], references: [id])
  type       String // "hls" | "dash"
  url        String
  filePath   String
  bandwidths Int[]
  createdAt  DateTime @default(now())
}

model UploadSession {
  id        String   @id
  fileName  String
  fileSize  BigInt
  offset    BigInt   @default(0)
  status    String   @default("active")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
}

model LiveRoom {
  id          String          @id @default(uuid())
  title       String
  description String?
  coverUrl    String?
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id])
  streamKey   String          @unique
  viewPassword String?
  status      LiveRoomStatus  @default(NOT_STARTED)
  pushUrl     String?
  playUrlHls  String?
  playUrlFlv  String?
  playUrlRtc  String?
  isPublic    Boolean         @default(true)
  maxBitrate  Int?
  isRecorded  Boolean         @default(true)
  recordFormat LiveRecordingFormat @default(FLV)
  startTime   DateTime?
  endTime     DateTime?
  duration    Int             @default(0)
  viewCount   Int             @default(0)
  peakViewers Int             @default(0)
  likeCount   Int             @default(0)
  banReason   String?
  streams     LiveStream[]
  transcodes  LiveTranscode[]
  recordings  LiveRecording[]
  plans       LivePlan[]
  danmakus    Danmaku[]
  likes       LiveLike[]
  gifts       LiveGiftLog[]
  viewers     LiveViewer[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
}

model LiveStream {
  id           String            @id @default(uuid())
  liveRoomId   String
  liveRoom     LiveRoom          @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  streamIndex  Int               @default(0)
  streamName   String
  protocol     LiveStreamProtocol @default(RTMP)
  status       LiveStreamStatus  @default(PUSHING)
  bitrate      Int?
  width        Int?
  height       Int?
  codec        String?
  connectedAt  DateTime?
  disconnectedAt DateTime?
  duration     Int               @default(0)
  isPrimary    Boolean           @default(true)
  pushIp       String?
  metadata     Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([liveRoomId])
  @@index([status])
}

model LiveTranscode {
  id            String             @id @default(uuid())
  liveRoomId    String
  liveRoom      LiveRoom           @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  templateId    String?
  template      TranscodeTemplate? @relation(fields: [templateId], references: [id])
  name          String
  width         Int
  height        Int
  videoBitrate  Int
  audioBitrate  Int?
  videoCodec    VideoCodec         @default(H264)
  audioCodec    AudioCodec         @default(AAC)
  framerate     Int?
  status        LiveTranscodeStatus @default(RUNNING)
  outputUrl     String?
  outputPath    String?
  isBackup      Boolean            @default(false)
  mainTranscodeId String?
  mainTranscode LiveTranscode?     @relation("BackupTranscode", fields: [mainTranscodeId], references: [id])
  backupTranscodes LiveTranscode[] @relation("BackupTranscode")
  latencyMs     Int               @default(0)
  lastCheckAt   DateTime?
  errorMessage  String?
  startedAt     DateTime?
  stoppedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([liveRoomId])
  @@index([status])
}

model LiveRecording {
  id          String              @id @default(uuid())
  liveRoomId  String
  liveRoom    LiveRoom            @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  format      LiveRecordingFormat @default(FLV)
  status      LiveRecordingStatus @default(RECORDING)
  filePath    String?
  fileSize    BigInt?
  duration    Int                 @default(0)
  segmentIndex Int                @default(0)
  sliceDuration Int?
  videoId     String?
  video       Video?              @relation(fields: [videoId], references: [id], onDelete: SetNull)
  startedAt   DateTime
  stoppedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([liveRoomId])
  @@index([status])
}

model LivePlan {
  id          String   @id @default(uuid())
  liveRoomId  String
  liveRoom    LiveRoom @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  title       String
  scheduledAt DateTime
  duration    Int
  description String?
  isNotified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([liveRoomId])
  @@index([scheduledAt])
}

model Danmaku {
  id         String        @id @default(uuid())
  liveRoomId String
  liveRoom   LiveRoom      @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  userId     String
  userName   String
  content    String
  color      String        @default("#FFFFFF")
  fontSize   Int           @default(24)
  mode       Int           @default(1)
  status     DanmakuStatus @default(NORMAL)
  createdAt  DateTime      @default(now())

  @@index([liveRoomId])
  @@index([userId])
  @@index([createdAt])
}

model Gift {
  id        String       @id @default(uuid())
  name      String
  iconUrl   String
  price     Decimal      @db.Decimal(10, 2)
  value     Int
  status    GiftStatus   @default(ENABLED)
  sortOrder Int          @default(0)
  giftLogs  LiveGiftLog[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model LiveGiftLog {
  id         String   @id @default(uuid())
  liveRoomId String
  liveRoom   LiveRoom @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  giftId     String
  gift       Gift     @relation(fields: [giftId], references: [id])
  userId     String
  userName   String
  quantity   Int
  totalValue Int
  createdAt  DateTime @default(now())

  @@index([liveRoomId])
  @@index([userId])
  @@index([createdAt])
}

model LiveLike {
  id         String   @id @default(uuid())
  liveRoomId String
  liveRoom   LiveRoom @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  userId     String
  createdAt  DateTime @default(now())

  @@index([liveRoomId])
  @@index([userId])
}

model LiveViewer {
  id          String   @id @default(uuid())
  liveRoomId  String
  liveRoom    LiveRoom @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  userId      String
  userName    String
  protocol    LivePlayProtocol @default(HLS)
  connectedAt DateTime @default(now())
  disconnectedAt DateTime?
  isActive    Boolean  @default(true)

  @@index([liveRoomId])
  @@index([userId])
  @@index([isActive])
}
