// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoStatus {
  UPLOADING
  UPLOADED
  TRANSCODING
  TRANSCODED
  PUBLISHED
  FAILED
  ARCHIVED
}

enum TranscodeStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
}

enum VideoCodec {
  H264
  H265
  AV1
}

enum AudioCodec {
  AAC
  MP3
  OPUS
}

enum ThumbnailFormat {
  JPG
  PNG
  WEBP
}

model Video {
  id             String          @id @default(uuid())
  title          String
  description    String?
  fileName       String
  originalPath   String
  fileSize       BigInt
  duration       Float?
  width          Int?
  height         Int?
  bitrate        Int?
  format         String?
  status         VideoStatus     @default(UPLOADING)
  uploadId       String?
  uploadProgress Int             @default(0)
  thumbnailUrl   String?
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  tags           VideoTag[]
  transcodeTasks TranscodeTask[]
  thumbnails     Thumbnail[]
  playlists      Playlist[]
  metadata       Json?
  views          Int             @default(0)
  isPublic       Boolean         @default(true)
  expiresAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  videos      Video[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id        String     @id @default(uuid())
  name      String     @unique
  videos    VideoTag[]
  createdAt DateTime   @default(now())
}

model VideoTag {
  videoId String
  tagId   String
  video   Video  @relation(fields: [videoId], references: [id])
  tag     Tag    @relation(fields: [tagId], references: [id])

  @@id([videoId, tagId])
}

model TranscodeTemplate {
  id             String          @id @default(uuid())
  name           String
  description    String?
  isPreset       Boolean         @default(false)
  width          Int?
  height         Int?
  videoBitrate   Int?
  videoCodec     VideoCodec      @default(H264)
  audioBitrate   Int?
  audioCodec     AudioCodec      @default(AAC)
  framerate      Int?
  crf            Int?
  preset         String?
  outputFormat   String          @default("mp4")
  isHls          Boolean         @default(false)
  isDash         Boolean         @default(false)
  transcodeTasks TranscodeTask[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([isPreset])
}

model TranscodeTask {
  id           String             @id @default(uuid())
  videoId      String
  video        Video              @relation(fields: [videoId], references: [id])
  templateId   String?
  template     TranscodeTemplate? @relation(fields: [templateId], references: [id])
  templateName String
  status       TranscodeStatus    @default(PENDING)
  progress     Int                @default(0)
  outputPath   String?
  outputSize   BigInt?
  width        Int?
  height       Int?
  bitrate      Int?
  duration     Float?
  retryCount   Int                @default(0)
  maxRetries   Int                @default(3)
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([videoId])
  @@index([status])
  @@index([createdAt])
}

model Thumbnail {
  id         String          @id @default(uuid())
  videoId    String
  video      Video           @relation(fields: [videoId], references: [id])
  filePath   String
  url        String
  timePoint  Float
  width      Int
  height     Int
  format     ThumbnailFormat @default(JPG)
  fileSize   BigInt
  isSprite   Boolean         @default(false)
  spriteData Json?
  createdAt  DateTime        @default(now())

  @@index([videoId])
}

model Playlist {
  id         String   @id @default(uuid())
  videoId    String
  video      Video    @relation(fields: [videoId], references: [id])
  type       String // "hls" | "dash"
  url        String
  filePath   String
  bandwidths Int[]
  createdAt  DateTime @default(now())
}

model UploadSession {
  id        String   @id
  fileName  String
  fileSize  BigInt
  offset    BigInt   @default(0)
  status    String   @default("active")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
}
