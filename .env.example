# Server Configuration
PORT=3000
NODE_ENV=development
# Public host for generating push/play URLs (e.g. your-domain.com or 192.168.1.100)
PUBLIC_HOST=

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/media_service?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# MinIO / S3 Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_VIDEO_BUCKET=videos
MINIO_THUMBNAIL_BUCKET=thumbnails

# FFmpeg Configuration
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Upload Configuration
UPLOAD_TEMP_DIR=./uploads
MAX_FILE_SIZE=10737418240
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/x-msvideo,video/x-matroska,video/webm,video/ogg

# Transcode Configuration
TRANSCODE_CONCURRENCY=2
TRANSCODE_MAX_RETRIES=3
